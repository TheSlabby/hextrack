# HexTrack v2 configuration. Copy to .env (repo root) or api/.env and fill in.
# Environment variables override both files; api/.env overrides the root .env.

# --- Database --------------------------------------------------------------------------
# Local Postgres 16 (docker compose up -d db, or `make db-start` for Homebrew).
DATABASE_URL=postgresql+asyncpg://hextrack:hextrack@localhost:5432/hextrack

# --- Riot API ----------------------------------------------------------------------------
# https://developer.riotgames.com. Leave empty to run without Riot (demo data only).
RIOT_API_KEY=
RIOT_PLATFORM=na1
RIOT_REGION=americas
# Application rate limits as count:seconds pairs (dev key default: 20/1s, 100/120s).
# These are a ceiling: the limits Riot announces are capped by whatever is configured here
# for the same window, so lowering a value really does reserve part of the key.
RIOT_APP_RATE_LIMITS=20:1,100:120
# The share of the key the public endpoints (player lookups, the Update button) may spend.
# They fail fast with 429 beyond it, and the worker reserves this share for them, so a
# long backfill cannot starve the website. Leave empty to disable both.
RIOT_ONDEMAND_RATE_LIMITS=5:1,20:120
# Longest an HTTP request may wait in the rate limiter before it answers 429 instead of
# parking (the worker has no such bound).
RIOT_ONDEMAND_MAX_WAIT_SECONDS=5

# --- HexTrack ----------------------------------------------------------------------------
# Relative paths are resolved against api/.
HEXTRACK_MODEL_DIR=./artifacts
HEXTRACK_WEB_DIST=../web/dist
# Bearer token for PUT/DELETE /api/v1/roster/... (admin API disabled when empty).
HEXTRACK_ADMIN_TOKEN=
# Season start (tz-aware ISO-8601). LP deltas and backfills start here.
HEXTRACK_SEASON_START=2026-01-08T20:00:00Z
HEXTRACK_POLL_INTERVAL_SECONDS=120
HEXTRACK_POLL_MATCH_COUNT=20
HEXTRACK_BACKFILL_COUNT=100
HEXTRACK_ONDEMAND_COOLDOWN_SECONDS=120
HEXTRACK_ONDEMAND_MAX_MATCHES=10
# Comma-separated origins allowed by CORS (the Vite dev server).
HEXTRACK_CORS_ORIGINS=http://localhost:5173
# Public URL of the web app (used for links in Discord embeds).
HEXTRACK_PUBLIC_URL=http://localhost:5173
# Base URL for rank emblem images in embeds (optional).
HEXTRACK_RANK_ICON_BASE=

# --- Discord bot -------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_BROADCAST_CHANNEL_ID=
DISCORD_DAILY_POST_HOUR=6
DISCORD_TZ=America/Chicago
HEXTRACK_BAD_GAME_EMBEDS=false
