[Unit]
Description=HexTrack API and website (127.0.0.1:8000, exposed on Tailscale)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=exec
User=hextrack
Group=hextrack
EnvironmentFile=/etc/hextrack/hextrack.env
LoadCredential=RIOT_API_KEY:/etc/hextrack/credentials/RIOT_API_KEY
LoadCredential=HEXTRACK_ADMIN_TOKEN:/etc/hextrack/credentials/HEXTRACK_ADMIN_TOKEN
CacheDirectory=hextrack
ExecStart=/opt/hextrack/current/venv/bin/python -m hextrack serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
MemoryMax=1536M
# No MemoryDenyWriteExecute: torch's oneDNN JIT (Xbyak) needs W+X pages. Tested 2026-09-24:
# it fails with "Xbyak::Error" and falls back to slower kernels.

[Install]
WantedBy=multi-user.target
