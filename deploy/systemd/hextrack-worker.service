[Unit]
Description=HexTrack Riot poller (roster matches, ranks, AI scores)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=exec
User=hextrack
Group=hextrack
EnvironmentFile=/etc/hextrack/hextrack.env
LoadCredential=RIOT_API_KEY:/etc/hextrack/credentials/RIOT_API_KEY
CacheDirectory=hextrack
ExecStart=/opt/hextrack/current/venv/bin/python -m hextrack worker
Restart=on-failure
RestartSec=10
MemoryMax=1536M
# No MemoryDenyWriteExecute: torch's oneDNN JIT (Xbyak) needs W+X pages. Tested 2026-09-24:
# it fails with "Xbyak::Error" and falls back to slower kernels.

[Install]
WantedBy=multi-user.target
